/* Stylesheet unico per tutti i temi. I segnaposto con il dollaro sono i colori del tema (app/theme.py), {N} = pixel scalati sullo schermo. */

QWidget {
    background-color: $bg;
    color: $text;
    font-size: {16}px;
    font-family: UIFONTS;
}
QDialog#LoginDialog { background-color: $bg; }
QDialog#Modal { background: transparent; }
QWidget#ModalOverlay { background-color: $overlay; }

QLabel { background: transparent; }
QLabel#ClockTime { font-size: {26}px; font-weight: 700; color: $text; }
QLabel#ClockDate { font-size: {15}px; color: $muted; }
QLabel#Version { color: $faint; font-size: {14}px; }
QLabel#LoginTitle { font-size: {32}px; font-weight: 700; }
QLabel#DialogTitle { font-size: {24}px; font-weight: 700; }
QLabel#Muted { color: $muted; font-size: {18}px; }
QLabel#Counter { color: $muted2; font-size: {18}px; }
QLabel#DetailDesc { font-weight: 700; color: $text_strong; }
QLabel#DetailLayout { font-weight: 800; color: $layout_green; }
QLabel#DetailCode { font-family: MONOFONTS; color: $muted2; }
QLabel#DetailFull { color: $muted; }
QScrollArea#DetailFullScroll { background: transparent; border: none; }
QScrollArea#DetailFullScroll > QWidget > QWidget { background: transparent; }
QLabel#InfoText { font-size: {20}px; color: $text; }
QLabel#SettingTitle { font-size: {20}px; font-weight: 600; color: $text; }
QLabel#SettingDesc { font-size: {15}px; color: $muted; }
QLabel#EmptyTitle { font-size: {28}px; font-weight: 700; color: $text; }
QLabel#EmptySub { font-size: {18}px; color: $muted; }

/* card della pagina (login) e card della tabella */
QFrame#Card {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: {18}px;
}
QFrame#Card QLabel { background: transparent; }
QFrame#TableCard {
    background-color: $card_bg;
    border: 1px solid $border;
    border-radius: {16}px;
}
QWidget#EmptyState { background: transparent; }
QFrame#Divider { background-color: $divider; border: none; }
QFrame#RowDivider { background-color: $border; border: none; }

/* modali: tinta diversa dall'app, bordo con accento (l'ombra e' in codice) */
QFrame#ModalCard {
    background-color: $modal_bg;
    border: 2px solid $accent;
    border-radius: {20}px;
}
QFrame#ModalCard QLabel { background: transparent; }

QLineEdit {
    background-color: $surface;
    border: 2px solid $border;
    border-radius: {12}px;
    padding: {8}px {14}px;
    font-size: {20}px;
    selection-background-color: $sel;
    selection-color: #FFFFFF;
}
QLineEdit#MainSearch { font-size: {26}px; padding: {10}px {16}px; }
QLineEdit:hover { border-color: $border_hover; }
QLineEdit:focus { border-color: $accent; }
QLineEdit:disabled { background-color: $dis_bg; color: $dis_text; border-color: $border; }

QPushButton {
    background-color: $primary;
    color: #FFFFFF;
    border: none;
    border-radius: {12}px;
    padding: {10}px {22}px;
    font-size: {20}px;
    font-weight: 600;
}
QPushButton:hover { background-color: $primary_hover; }
QPushButton:pressed { background-color: $primary_press; }
QPushButton:disabled { background-color: $dis_bg; color: $dis_text; }

/* pulsante accento con effetto "premuto": il bordo 3D passa da sotto a sopra */
QPushButton#AccentButton {
    background-color: $accent;
    color: #FFFFFF;
    border-top: {3}px solid transparent;
    border-bottom: {3}px solid $accent_edge;
    border-left: none; border-right: none;
    border-radius: {12}px;
    padding: {7}px {22}px;
}
QPushButton#AccentButton:hover { background-color: $accent_hover; }
QPushButton#AccentButton:pressed {
    background-color: $accent_press;
    border-top: {3}px solid $accent_edge;
    border-bottom: {3}px solid transparent;
}
QPushButton#AccentButton:disabled {
    background-color: $dis_bg; color: $dis_text;
    border-top: {3}px solid transparent; border-bottom: {3}px solid transparent;
}

QPushButton#SuccessButton { background-color: #2E8B57; }
QPushButton#SuccessButton:hover { background-color: #37A267; }
QPushButton#SuccessButton:pressed { background-color: #256F46; }
QPushButton#DangerButton { background-color: #8B1E24; }
QPushButton#DangerButton:hover { background-color: #A8282F; }
QPushButton#DangerButton:pressed { background-color: #701A1E; }
QPushButton#SecondaryButton { background-color: $sec_bg; color: $text; }
QPushButton#SecondaryButton:hover { background-color: $sec_hover; }
QPushButton#KeyButton { background-color: $key_bg; color: $key_text; font-size: {24}px; padding: 0px; }
QPushButton#KeyButton:hover { background-color: $key_hover; }
QPushButton#KeyButton:pressed { background-color: $accent; color: #FFFFFF; }

QPushButton#IconButton {
    background-color: $primary;
    border: 1px solid $primary_border;
    border-radius: {10}px;
    padding: 0px;
}
QPushButton#IconButton:hover { background-color: $icon_hover; border: 1px solid $icon_hover_border; }
QPushButton#IconButton:pressed { background-color: $primary_press; border: 1px solid $primary_border; }
QPushButton#IconButton:disabled { background-color: $dis_bg; border: 1px solid $border; }
QPushButton#IconButton[danger="true"]:hover { background-color: #8B1E24; border: 1px solid #E26A6F; }
QPushButton#IconButton[danger="true"]:pressed { background-color: #701A1E; }
QToolTip { background-color: $tooltip_bg; color: $text; border: 1px solid $border_hover; padding: {4}px {8}px; font-size: {15}px; }

/* interruttore segmentato (tema) */
QFrame#Segmented { background-color: $surface_alt; border: 1px solid $border; border-radius: {12}px; }
QPushButton#SegButton {
    background: transparent; color: $muted2; border-radius: {9}px;
    padding: {8}px {26}px; font-size: {18}px; font-weight: 600;
}
QPushButton#SegButton:hover { background-color: $sec_hover; }
QPushButton#SegButton:checked { background-color: $accent; color: #FFFFFF; }

QTableView {
    background-color: $table_bg;
    alternate-background-color: $table_alt;
    color: $text;
    gridline-color: $grid;
    border: none;
    selection-background-color: $sel;
    selection-color: #FFFFFF;
    outline: 0;
}
QTableView::item { padding: 0px {6}px; }
QHeaderView::section {
    background-color: $header_bg;
    color: #FFFFFF;
    font-size: {19}px;
    font-weight: 700;
    padding: {8}px {10}px;
    border: none;
    border-right: 1px solid $grid;
    border-bottom: 1px solid $grid;
}
QHeaderView::section:hover { background-color: $header_hover; }

QScrollBar:vertical { background: $scroll_track; width: {18}px; margin: 0; }
QScrollBar::handle:vertical { background: $scroll_handle; border-radius: {7}px; min-height: {40}px; margin: {2}px; }
QScrollBar::handle:vertical:hover { background: $scroll_handle_hover; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: $scroll_track; height: {18}px; margin: 0; }
QScrollBar::handle:horizontal { background: $scroll_handle; border-radius: {7}px; min-width: {40}px; margin: {2}px; }

QProgressBar { background: $surface; border: none; border-radius: {6}px; max-height: {12}px; }
QProgressBar::chunk { background: $accent; border-radius: {6}px; }

QLabel#Toast {
    color: #FFFFFF;
    font-size: {20}px;
    font-weight: 600;
    padding: {14}px {28}px;
    border-radius: {14}px;
    background-color: $primary;
}
QLabel#Toast[kind="error"] { background-color: #B0302E; }
QLabel#Toast[kind="success"] { background-color: #2E8B57; }
QLabel#Toast[kind="info"] { background-color: $primary; }

QTabWidget::pane { border: 1px solid $border; border-radius: {12}px; background: $surface; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: $tab_bg; color: $muted2; padding: {10}px {28}px; margin-right: {6}px;
    border-top-left-radius: {10}px; border-top-right-radius: {10}px; font-size: {18}px; font-weight: 600;
}
QTabBar::tab:hover { background: $tab_hover; color: $text; }
QTabBar::tab:selected { background: $accent; color: #FFFFFF; }
QWidget#TabPage { background: transparent; }
QTabWidget QStackedWidget { background: transparent; }

/* ---- wizard "Configurazione file" ---- */
QLabel#StepPill {
    background-color: $surface_alt; color: $muted; border: 1px solid $border;
    border-radius: {16}px; padding: {6}px {16}px; font-size: {16}px; font-weight: 600;
}
QLabel#StepPill[state="active"] { background-color: $accent; color: #FFFFFF; border-color: $accent; }
QLabel#StepPill[state="done"] { background-color: $surface; color: $accent; border-color: $accent; }
QLabel#StepArrow { color: $faint; font-size: {18}px; }
QLabel#WizardInfo { font-size: {18}px; color: $text; }
QLabel#WizardHint { font-size: {15}px; color: $muted; }
QLabel#WizardWarn { font-size: {15}px; color: $warn; font-weight: 600; }
QLabel#FormCaption { font-size: {14}px; color: $muted; }
QLabel#GroupTitle { font-size: {17}px; font-weight: 700; color: $text; }
QLabel#ColName { font-size: {18}px; font-weight: 600; color: $text; }
QLabel#ColSample { font-size: {14}px; color: $muted; }
QLabel#StepperValue { font-size: {20}px; font-weight: 700; color: $text; }
QLabel#PreviewTitle { font-size: {14}px; color: $muted; font-weight: 600; }
QLabel#DetailInvalidMsg { font-size: {15}px; color: $danger_text; font-weight: 600; }
QLabel#DetailInvalidCode { font-weight: 800; color: $text_strong; }
QLabel#InfoKey { font-size: {16}px; color: $muted; }
QLabel#InfoValue { font-size: {18}px; font-weight: 600; color: $text; }

QFrame#PreviewCard { background-color: $modal_bg; border: 2px solid $accent; border-radius: {14}px; }
QFrame#PreviewCard QLabel { background: transparent; }
QFrame#ColumnRow { background-color: $surface; border: 1px solid $border; border-radius: {10}px; }
QFrame#ColumnRow:hover { border-color: $border_hover; }
QFrame#GroupBox { background-color: $surface; border: 1px solid $border; border-radius: {12}px; }
QFrame#GroupBox QLabel { background: transparent; }
QScrollArea#WizardScroll { background: transparent; border: none; }
QScrollArea#WizardScroll > QWidget > QWidget { background: transparent; }

QPushButton#MoveButton {
    background-color: $sec_bg; color: $text; border-radius: {8}px; padding: 0px; font-size: {16}px; font-weight: 700;
}
QPushButton#MoveButton:hover { background-color: $sec_hover; }
QPushButton#MoveButton:pressed { background-color: $accent; color: #FFFFFF; }
QPushButton#MoveButton:disabled { background-color: transparent; color: $dis_text; }
QPushButton#StepperButton {
    background-color: $sec_bg; color: $text; border-radius: {10}px; padding: 0px; font-size: {24}px; font-weight: 700;
}
QPushButton#StepperButton:hover { background-color: $sec_hover; }
QPushButton#StepperButton:pressed { background-color: $accent; color: #FFFFFF; }

QListWidget#SheetList { background-color: $surface; border: 1px solid $border; border-radius: {12}px; outline: 0; padding: {4}px; }
QListWidget#SheetList::item { border: 1px solid $border; border-radius: {10}px; padding: {10}px {14}px; margin: {3}px; font-size: {19}px; }
QListWidget#SheetList::item:hover { border-color: $border_hover; }
QListWidget#SheetList::item:selected { background-color: $accent; color: #FFFFFF; border-color: $accent; }

QCheckBox { spacing: {10}px; background: transparent; }
QCheckBox::indicator { width: {26}px; height: {26}px; border-radius: {7}px; border: 2px solid $border_hover; background: $surface; }
QCheckBox::indicator:hover { border-color: $accent; }
QCheckBox::indicator:checked { background: $accent; border-color: $accent; image: url(CHECKICON); }

QComboBox {
    background-color: $surface; border: 2px solid $border; border-radius: {10}px;
    padding: {6}px {12}px; min-height: {30}px; font-size: {17}px; color: $text;
}
QComboBox:hover { border-color: $border_hover; }
QComboBox:focus, QComboBox:on { border-color: $accent; }
QComboBox:disabled { background-color: $dis_bg; color: $dis_text; }
QComboBox::drop-down { border: none; width: {30}px; }
QComboBox::down-arrow { image: url(CHEVRONICON); width: {14}px; height: {14}px; }
QComboBox QAbstractItemView {
    background-color: $surface; color: $text; border: 1px solid $accent; outline: 0;
    selection-background-color: $accent; selection-color: #FFFFFF; font-size: {17}px;
}
QComboBox QAbstractItemView::item { min-height: {36}px; padding: {4}px {10}px; }
QStackedWidget { background: transparent; }

QTableWidget#TextPreview {
    background-color: $table_bg; alternate-background-color: $table_alt; color: $text;
    gridline-color: $grid; border: 1px solid $border; border-radius: {10}px; font-size: {15}px;
}
QTableWidget#TextPreview QHeaderView::section { font-size: {15}px; padding: {4}px {8}px; }
